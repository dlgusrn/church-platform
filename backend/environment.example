APP_ENV=development
APP_NAME="Church App API"
DATABASE_URL=mysql+pymysql://church_app:church-app-dev-only@127.0.0.1:3307/church_app?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://church_app:church-app-dev-only@127.0.0.1:3307/church_app_test?charset=utf8mb4
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SYNOLOGY_BASE_URL=https://nas.example.com:5001
SYNOLOGY_USERNAME=replace-with-service-account
SYNOLOGY_PASSWORD=replace-with-secret
SYNOLOGY_VIDEO_ROOT=/replace-with-video-root
SYNOLOGY_ALLOW_INSECURE_TLS=false
